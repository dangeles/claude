{
  "model": "claude-opus-5",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session-scope-guard.py"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/rm-rf-sanity-guard.py"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/ipynb-output-warn.py"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/secret-leak-guard.py"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/skill-frontmatter-validator.py"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/genesis-token-guard.py"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/secret-leak-guard.py"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/skill-frontmatter-validator.py"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/genesis-token-guard.py"
          }
        ]
      },
      {
        "matcher": "NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/secret-leak-guard.py"
          }
        ]
      },
      {
        "matcher": "Read|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/paper-context-guard.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/scratch-redirect-suggest.py"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/read-burst-nudge.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session-start-context.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/claude-config-planning-required.py"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/stale-todo-tracker.py"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/claude-md-improver-suggest.py"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/context-budget-warn.py"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true
  },
  "effortLevel": "high"
}
